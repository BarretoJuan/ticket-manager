# --- Django ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Values below are the Docker Compose defaults. For a local (non-Docker)
# PostgreSQL instance, set DB_HOST=localhost and DB_PORT=5432.
DB_NAME=ticket_manager
DB_USER=ticket_user
DB_PASSWORD=ticket_password
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=1

# --- Rate limiting (per client IP for login/register, per user for /book) ---
BOOK_THROTTLE_RATE=10/min
LOGIN_THROTTLE_RATE=10/min
REGISTER_THROTTLE_RATE=10/min

# --- Seeding (runs on every `docker compose up` / `manage.py seed`, idempotent) ---
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_USERS=alice@example.com,bob@example.com
SEED_BOOKINGS=true

# --- Email (booking confirmation e-mails) ---
# Docker Compose overrides EMAIL_HOST/EMAIL_PORT to the MailHog service
# (mailhog:1025) and exposes its web UI on http://localhost:8025. For plain
# `manage.py runserver` runs, point EMAIL_HOST at a local SMTP server (e.g.
# MailHog on localhost:1025) or leave it empty to disable e-mails locally.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false

# --- SAT open-data sync (art. 69 CFF "Cancelados") ---
# Window (minutes) during which a *successful* sync blocks a new one; bypassed
# with POST /api/v1/sat/sync?force=true.
SAT_SYNC_COOLDOWN_MINUTES=30
SAT_PAGE_URL=https://www.sat.gob.mx/minisitio/DatosAbiertos/contribuyentes_publicados.html
SAT_LINK_TEXT=Cancelados
SAT_HTTP_TIMEOUT_SECONDS=60
# Safety valve: hard cap on the downloaded CSV size (536870912 = 512 MB).
SAT_MAX_FILE_BYTES=536870912
# Rows per import batch (kept bounded so memory stays flat).
SAT_SYNC_BATCH_SIZE=5000