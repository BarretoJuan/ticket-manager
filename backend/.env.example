# --- Django ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Values below are the Docker Compose defaults. For a local (non-Docker)
# PostgreSQL instance, set DB_HOST=localhost and DB_PORT=5432.
DB_NAME=ticket_manager
DB_USER=ticket_user
DB_PASSWORD=ticket_password
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=1

# --- Rate limiting for POST /api/v1/events/<id>/book ---
BOOK_THROTTLE_RATE=10/min